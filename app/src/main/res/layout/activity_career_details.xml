<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ========================================= -->
    <!-- TOP BAR -->
    <!-- ========================================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/surface"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Career Details"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- SAVE STAR -->

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Save Career" />

    </LinearLayout>


    <!-- ========================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomActions">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ========================================= -->
            <!-- CAREER HEADER -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/txtCareerIcon"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:gravity="center"
                    android:text="💻"
                    android:textSize="48sp"
                    android:background="@drawable/bg_career_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="18dp">

                    <TextView
                        android:id="@+id/txtCareerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Software Developer"
                        android:textColor="@color/text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCareerCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Software &amp; Technology"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ========================================= -->
            <!-- ABOUT THIS CAREER -->
            <!-- ========================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="About This Career"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Software developers design, build, test and maintain software applications for users and organizations."
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp" />


            <!-- ========================================= -->
            <!-- SKILLS REQUIRED -->
            <!-- ========================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Skills Required"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSkills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="✓ Programming&#10;✓ Problem Solving&#10;✓ Data Structures &amp; Algorithms&#10;✓ Database Management&#10;✓ Git &amp; GitHub"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="8dp" />


            <!-- ========================================= -->
            <!-- TECHNOLOGIES -->
            <!-- ========================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Technologies"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTechnologies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Java  •  Python  •  SQL  •  Git  •  Android"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp" />


            <!-- ========================================= -->
            <!-- CAREER ROLES -->
            <!-- ========================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Career Roles"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRoles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="• Software Developer&#10;• Backend Developer&#10;• Full Stack Developer&#10;• Application Developer"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="8dp" />


            <!-- ========================================= -->
            <!-- CAREER ROADMAP -->
            <!-- ========================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Career Roadmap"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRoadmap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="01  Programming Basics&#10;&#10;02  Data Structures &amp; Algorithms&#10;&#10;03  Development Skills&#10;&#10;04  Build Projects&#10;&#10;05  Internship Preparation&#10;&#10;06  Job Preparation"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp" />

        </LinearLayout>

    </ScrollView>


    <!-- ========================================= -->
    <!-- BOTTOM ACTION BUTTONS -->
    <!-- ========================================= -->

    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:background="@color/background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ========================================= -->
        <!-- LEARNING RESOURCES -->
        <!-- ========================================= -->

        <Button
            android:id="@+id/btnLearningResources"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Learning Resources"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_outline_button"
            android:backgroundTint="@null" />

        <!-- ========================================= -->
        <!-- START ROADMAP -->
        <!-- ========================================= -->

        <Button
            android:id="@+id/btnStartRoadmap"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Start Roadmap"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:elevation="5dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>