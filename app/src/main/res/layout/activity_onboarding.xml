<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Skip -->
    <TextView
        android:id="@+id/txtSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="Skip"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Illustration -->
    <ImageView
        android:id="@+id/imgOnboarding"
        android:layout_width="280dp"
        android:layout_height="240dp"
        android:layout_marginTop="45dp"
        android:src="@drawable/ic_onboarding"
        android:contentDescription="Career guidance illustration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSkip"/>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:text="Discover Your Perfect Career"
        android:textColor="@color/text_primary"
        android:textSize="27sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgOnboarding"/>

    <!-- Description -->
    <TextView
        android:id="@+id/txtDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="35dp"
        android:gravity="center"
        android:text="Get guidance, resources and roadmaps to achieve your dreams."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"/>

    <!-- Page indicators -->
    <LinearLayout
        android:id="@+id/pageIndicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDescription">

        <View
            android:layout_width="24dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_indicator_active"/>

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_indicator_inactive"/>

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_indicator_inactive"/>

    </LinearLayout>

    <!-- Next button -->
    <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_primary_button"
        android:src="@android:drawable/ic_media_play"
        android:tint="@android:color/white"
        android:contentDescription="Continue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>